  "conv_num_skip": 2,
  "conv_dropout": 0.2,
  "is_regular_conv": true,
  "batch_size": 64,
  "learning_rate": 0.001,
  "min_lr": 0.00005,
  "weight_decay": 0.0001,
  "max_epochs": 80,
  "early_stopping_patience": 10,
  "reduce_lr_patience": 3,
  "reduce_lr_factor": 0.5,
  "num_workers": 0,
  "pin_memory": true,
  "amp": true,
  "seed": 42
}
