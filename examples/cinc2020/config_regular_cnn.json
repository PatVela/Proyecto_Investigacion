{
  "dataset": "PhysioNet/CinC Challenge 2020",
  "label_schema": "cinc2020_12_grouped_snomed_v2",
  "problem_type": "multilabel",
  "train": "data/cinc2020_12/train.h5",
  "dev": "data/cinc2020_12/val.h5",
  "test": "data/cinc2020_12/test.h5",
  "save_dir": "saved/cinc2020",
  "num_leads": 12,
  "input_length": 5000,
  "num_classes": 12,
  "conv_filter_length": 7,
