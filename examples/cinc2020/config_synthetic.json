{
  "dataset": "Synthetic smoke-test CINC2020-12",
  "label_schema": "cinc2020_12_grouped_snomed_v2",
  "problem_type": "multilabel",
  "train": "data/cinc2020_synth/train.h5",
  "dev": "data/cinc2020_synth/val.h5",
  "test": "data/cinc2020_synth/test.h5",
  "save_dir": "saved/cinc2020_synth",
  "num_leads": 12,
  "input_length": 5000,
  "num_classes": 12,
  "conv_filter_length": 7,
  "conv_num_filters_start": 8,
  "conv_subsample_lengths": [1, 2, 1, 2],
  "conv_num_skip": 2,
  "conv_dropout": 0.1,
  "batch_size": 4,
  "learning_rate": 0.001,
  "min_lr": 0.00005,
  "weight_decay": 0.0001,
  "max_epochs": 2,
  "early_stopping_patience": 2,
  "reduce_lr_patience": 1,
  "reduce_lr_factor": 0.5,
  "num_workers": 0,
  "pin_memory": false,
  "amp": false,
  "seed": 42
}
